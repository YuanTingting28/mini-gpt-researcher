# 复制本文件为 .env 后填写。.env 不要提交到 git。

# ---- 模型 ----
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

FAST_LLM=deepseek:deepseek-flash
SMART_LLM=deepseek:deepseek-flash
STRATEGIC_LLM=deepseek:deepseek-flash
TEMPERATURE=0.4

# 上限 8192，超了 API 会拒绝。
# 注意：推理模型会先花掉一部分额度思考，所以别设太小，否则正文会是空的。
# 实测同一个提示词，推理长度在 14~115 token 之间波动，建议 >= 1024。
SMART_TOKEN_LIMIT=4000

# ---- 检索 ----
RETRIEVER=tavily,arxiv
TAVILY_API_KEY=
MAX_SEARCH_RESULTS=6
MAX_SUB_QUERIES=4

# ---- 上下文 ----
# deepseek 没有 embedding 接口，只能用 keyword
CONTEXT_FILTER=keyword
COMPRESSION_THRESHOLD=8000
KEYWORD_RELATIVE_THRESHOLD=0.5
KEYWORD_MAX_RESULTS=25

# ---- 成稿 ----
REPORT_TYPE=research_report
TOTAL_WORDS=1000

# ---- 抓取 ----
SCRAPE_TIMEOUT=15
LLM_TIMEOUT=120

# ---- 来源管家（阶段13）----
CURATE_SOURCES=0
CURATE_MAX_RESULTS=10
CURATE_SNIPPET_CHARS=600

# ---- MCP server（阶段14）----
MCP_HOST=127.0.0.1
MCP_PORT=8170